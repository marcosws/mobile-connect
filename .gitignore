# Go
# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out

# Dependency directories (vendor can be committed if desired)
vendor/
Godeps/

# Build directories
bin/
pkg/

# IDEs and editors
.idea/
.vscode/
*.iml

# OS generated files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# Logs and temporary files
*.log
tmp/
temp/

# Swap files
*.swp

# Ignore storage folder and all its subfolders/files
storage/
storage/**
